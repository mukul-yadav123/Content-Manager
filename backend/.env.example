# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_signing_secret

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/linkedin_content_studio

# Redis Configuration (BullMQ & Cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1-mini

# Storage Configuration (Local server storage with automatic pruning - No third-party account required)
STORAGE_DRIVER=local
SERVER_URL=http://localhost:5000
UPLOAD_RETENTION_HOURS=48

# Cloudinary Storage Configuration (Optional - Not needed when STORAGE_DRIVER=local)
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

